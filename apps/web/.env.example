# ==============================================================================
# Aurangabad Smart Ambulance — Web Frontend Environment Template
# ==============================================================================

# Backend Fastify API Base URL
# Leave empty for local development to use the Vite dev server proxy (http://localhost:4000).
# For production (e.g., hosted on Render, Railway, Fly.io, or VPS), set to your backend public URL:
# Example: VITE_API_URL=https://aurangabad-ambulance-api.onrender.com
VITE_API_URL=

# Real-time WebSocket / Socket.IO Server URL
# Defaults to VITE_API_URL if omitted.
# Example: VITE_WS_URL=https://aurangabad-ambulance-api.onrender.com
VITE_WS_URL=
