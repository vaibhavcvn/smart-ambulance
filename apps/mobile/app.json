{
  "expo": {
    "name": "Aurangabad Smart Ambulance",
    "slug": "aurangabad-smart-ambulance",
    "scheme": "aurangabad-ems",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.aurangabad.smartambulance",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Aurangabad Smart Ambulance to use your location for emergency dispatch routing."
        }
      ]
    ],
    "extra": {
      "defaultApiUrl": "https://bull-emerging-knee-posted.trycloudflare.com",
      "eas": {
        "projectId": "1b783351-f478-43fc-a01f-15be369e1f16"
      }
    }
  }
}
