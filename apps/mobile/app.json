{
  "expo": {
    "name": "Aurangabad Smart Ambulance",
    "slug": "aurangabad-smart-ambulance",
    "scheme": "aurangabad-ems",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090b"
      },
      "package": "com.aurangabad.smartambulance",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Aurangabad Smart Ambulance to use your location for emergency dispatch routing."
        }
      ]
    ],
    "extra": {
      "defaultApiUrl": "http://10.0.2.2:4000"
    }
  }
}
