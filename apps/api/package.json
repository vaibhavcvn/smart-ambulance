{
  "name": "@aurangabad-ambulance/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && prisma generate --schema=./prisma/schema.postgres.prisma && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:postgres:generate": "prisma generate --schema=./prisma/schema.postgres.prisma",
    "db:postgres:push": "prisma db push --schema=./prisma/schema.postgres.prisma",
    "db:postgres:migrate-data": "tsx prisma/migrate-sqlite-to-postgres.ts",
    "ml:train": "tsx src/ml/training/train.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/tests/unit",
    "test:e2e": "vitest run src/tests/e2e"
  },
  "dependencies": {
    "@aurangabad-ambulance/shared": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.3.1",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ml-random-forest": "^2.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
