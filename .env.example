# ==============================================================================
# Aurangabad Smart Ambulance — Environment Configuration Template
# ==============================================================================

# Server / API Configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database Configuration (SQLite path relative to apps/api)
DATABASE_URL=file:./dev.db

# Authentication & Security
JWT_SECRET=super_secret_aurangabad_emergency_jwt_key_development_only_change_in_prod_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Dispatch Engine Parameters
DISPATCH_TIMEOUT_SECONDS=45
DISPATCH_SEARCH_RADIUS_KM=25.0
MAX_DISPATCH_CANDIDATES=5

# Geocoding & Routing Services
# OSRM routing endpoint (Public demo server, fallback to internal Haversine / mock router if offline or rate limited)
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
# Nominatim Geocoding endpoint (Public demo OSM geocoder with User-Agent)
NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=AurangabadSmartAmbulance/1.0 (academic-prototype@aurangabad-emergency.local)

# ML Configuration
ML_MODEL_PATH=./data/ml/aurangabad_delay_rf.json
ENABLE_ML_PREDICTIONS=true

# Feature Flags
ENABLE_DEMO_GPS_SIMULATOR=true
ENABLE_CORS_ALL=false

# Logging Configuration (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
